{
  "name": "deeproot",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "demo",
    "api",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc -b shared demo api && npm run build --workspace web",
    "test": "vitest run",
    "build:live": "VITE_API_MODE=live npm run build -w web && npm run build:functions -w api",
    "dev:live": "VITE_API_MODE=live npm run dev -w web"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
