# Copy to api/.env and fill in. api/.env is git-ignored: never commit real keys.

# Linear personal API key (starts with lin_api_)
LINEAR_API_KEY=
# Team UUID: run `npm run linear:teams -w api` to look it up
LINEAR_TEAM_ID=
# Team key shown in issue IDs, e.g. DEE (used for the prefilled fallback link)
LINEAR_TEAM_KEY=

# Where the frontend is hosted; issue descriptions link back to the report
APP_BASE_URL=http://localhost:5173
