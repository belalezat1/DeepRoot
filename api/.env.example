# Copy to api/.env and fill in. api/.env is git-ignored: never commit real keys.
# With Azure access, run .\infra\write-local-settings.ps1 instead: it fills in every deployed value.
# Without keys, leave MODEL_PROVIDER unset and the model adapter returns stub replies.

# Linear personal API key (starts with lin_api_)
LINEAR_API_KEY=
# Team UUID: run `npm run linear:teams -w api` to look it up
LINEAR_TEAM_ID=
# Team key shown in issue IDs, e.g. DEE (used for the prefilled fallback link)
LINEAR_TEAM_KEY=

# Demo mode: every request acts as this user, with no sign-in. Leave empty to require sign-in.
DEMO_USER_ID=presenter

# Trusted account routing. Unset uses fictional Northstar/BetaCo mappings; {} disables routing.
# Accounts and their access lists must already exist in the configured account directory.
# EMAIL_ROUTING_JSON={"client@accounts.example.com":"client-id"}
# CONNECTOR_ACCOUNT_MAPS_JSON={"impl-tracker":{"CUSTOMER_CODE":"client-id"},"payroll-config":{"CUSTOMER_CODE":"client-id"}}
# When CONNECTOR_ACCOUNT_MAPS_JSON is supplied, unlisted connectors have no account mappings.

# Where the frontend is hosted; issue descriptions link back to the report
APP_BASE_URL=http://localhost:5173

# Model: gemini (default when deployed), azure, or stub. MODEL_FALLBACK answers when the first is rate limited or down.
MODEL_PROVIDER=stub
MODEL_FALLBACK=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=12000
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=chat
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure services (infra/README.md)
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_KEY=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=sources
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=deeproot

# Optional editable fictional apps. Disabled by default. configure:local generates a local token.
ENABLE_DEMO_APPS=false
DEMO_APP_ACCOUNT_IDS=northstar
DEMO_APPS_TOKEN=
DEMO_APPS_BASE_URL=http://localhost:7071
# Server-controlled HTTP exports. HTTPS required outside loopback; credentials never reach the browser.
# CONNECTOR_HTTP_JSON={"impl-tracker":{"url":"https://tools.example/export","tokenEnv":"CONNECTOR_TOKEN_TRACKER"}}
# CONNECTOR_TOKEN_TRACKER=
# Optional fail-closed upstream ACL/classification mapping; identities intersect account access.
# CONNECTOR_POLICIES_JSON={"impl-tracker":{"permissions":{"path":"readers","users":{"upstream-id":"presenter"}},"classification":{"path":"classification","deliveryValues":["delivery"]}}}
